NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# PostgreSQL connection used by @talkvyn/database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talkvyn?schema=public
# Optional one-time bootstrap account used by `pnpm --filter @talkvyn/database seed:staff`.
# Set all three values together. Use a unique strong password and keep it out of source control.
# STAFF_BOOTSTRAP_NAME=Talkvyn Administrator
# STAFF_BOOTSTRAP_EMAIL=admin@example.com
# STAFF_BOOTSTRAP_PASSWORD=
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=dev@talkvyn.local
# Optional comma-separated NestJS log levels.
# LOG_LEVELS=fatal,error,warn,log,debug,verbose

# Safe to expose in browser bundles.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
